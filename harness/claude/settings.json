{
  "env": {
    "DISABLE_AUTO_COMPACT": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CONFIG_DIR/hooks/fleet-state.sh\" session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CONFIG_DIR/hooks/fleet-state.sh\" stop"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CONFIG_DIR/hooks/fleet-state.sh\" notification"
          }
        ]
      }
    ]
  },
  "effortLevel": "xhigh",
  "theme": "dark",
  "autoCompactEnabled": false,
  "skipDangerousModePermissionPrompt": true
}
