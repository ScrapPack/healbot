<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily backup of the live opencode.db. See harness/backup-opencode-db.sh for the why,
     the method, and the TCC constraint that forces the libexec copy (launchd bash cannot
     read ~/Desktop). The home placeholders in the path strings below are rendered to the
     real home at install time — launchd expands neither ~ nor environment variables in
     ProgramArguments/log paths. Install (or re-install after editing either file):
       bash harness/install-db-backup.sh
     Fires daily at 13:00; launchd runs a missed firing on next wake (skipped if powered off). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.healbot.opencode-db-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.local/libexec/healbot/backup-opencode-db.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>13</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/healbot-opencode-db-backup.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/healbot-opencode-db-backup.log</string>
</dict>
</plist>
