{
  "$schema": "https://opencode.ai/config.json",

  // Default model for this harness. Routes to session/prompt/gpt.txt (9,284 B) via the
  // `gpt` branch of SystemPrompt.provider (session/system.ts:31-36), and selects the
  // `apply_patch` tool branch over `edit`+`write` (tool/registry.ts:292-295).
  // Set explicitly so the harness does not inherit whatever the global config's default
  // happens to be — that materially changes both the base prompt and the live tool set.
  //
  // PROVIDER PREFIX IS `openai`, NOT `opencode`. The catalog has openai/gpt-5.6-sol
  // (+ -fast, -pro) and no opencode/gpt-5.6-sol. The wrong prefix does not fall back --
  // it kills every session started anywhere in this repo before the first turn with
  // "Model not found: opencode/gpt-5.6-sol", because project config beats the harness's
  // own global config. Verified against `opencode models`.
  "model": "openai/gpt-5.6-sol",

  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
