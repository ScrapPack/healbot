#!/bin/bash
# The gate's enforcement trigger: a push whose commits do not pass gate/gate.py does not
# leave the machine. This closes the remember-to-run gap that GATE.MAP.md names as the reason
# the gate exists (the fork drift check sat silently red because nothing ran it).
#
# Install, once per clone (hooks are not versioned; this directory is):
#     git config core.hooksPath gate/hooks
# Escape hatch, git-native and deliberate: git push --no-verify. Using it means shipping
# unverified commits; say so wherever the push is discussed.
#
# Scope: gate.py --base diffs <base>...HEAD, so the gate sees the files the pushed commits
# changed. This repo pushes a single branch from HEAD, where that is exact; pushing a
# non-HEAD ref would gate an approximation of the range, which still runs every Tier-1
# probe and the banned-filename invariant regardless.
#
# After the gate passes, the model review stage (gate/review.py) runs on the same range:
# single-pass, fresh-context, typed findings, ADVISORY by default (findings are printed and
# recorded; the push continues). HEALBOT_REVIEW=blocking is fail-closed on severity: any
# finding not explicitly tagged warning or info refuses the push.
# HEALBOT_REVIEW=off skips the stage entirely. The reviewer needs a logged-in claude CLI;
# until one exists it reports ERROR and, in advisory mode, the push continues.
#
# HEALBOT_GATE / HEALBOT_REVIEW_CMD override the two commands for hook plumbing tests
# (stub exits 0/2/3). They add no bypass power that --no-verify does not already grant.
# After both stages pass, the evidence flow (gate/publish.py) is spawned DETACHED: it waits
# for the pushed sha to appear on the remote, then attaches the run records to the commit
# (or the branch's open PR). It never blocks a push; HEALBOT_PUBLISH=off skips it. The
# auditable property: a pushed commit with no evidence comment shipped via --no-verify.
set -u

ZERO=0000000000000000000000000000000000000000
ROOT="$(git rev-parse --show-toplevel)"
VENVPY="$ROOT/.carryover/verified/venv/bin/python"
# Windows venv layout puts the interpreter under Scripts/; fall through only when bin/ is absent.
[ -x "$VENVPY" ] || VENVPY="$ROOT/.carryover/verified/venv/Scripts/python.exe"
GATE=${HEALBOT_GATE:-"$VENVPY $ROOT/gate/gate.py"}
REVIEW=${HEALBOT_REVIEW_CMD:-"$VENVPY $ROOT/gate/review.py"}
PUBLISH=${HEALBOT_PUBLISH_CMD:-"$VENVPY $ROOT/gate/publish.py"}
T0=$(date +%s)

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote ref pushes no commits; there is nothing to gate.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$remote_sha"                    # normal push: gate exactly what the remote gains
  else
    # New remote ref, or a remote tip we have not fetched: fall back to the merge-base with
    # origin/main, and to a working-tree run if even that is unknown.
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  fi

  echo "pre-push gate: ${local_ref} -> ${remote_ref} (base ${base:-working tree})" >&2
  # /dev/null on stdin: a command inside a while-read loop otherwise inherits the loop's
  # stdin and can consume the remaining ref lines.
  if [ -n "$base" ]; then
    $GATE --base "$base" >&2 < /dev/null
  else
    $GATE >&2 < /dev/null
  fi
  code=$?
  if [ "$code" -ne 0 ]; then
    meaning="unknown"
    [ "$code" -eq 2 ] && meaning="BLOCKED: a check ran and said no"
    [ "$code" -eq 3 ] && meaning="ERROR: a check could not run, so the claim is unmeasured"
    echo "pre-push gate: REFUSING the push (gate exit $code, $meaning)." >&2
    echo "pre-push gate: evidence in gate/runs/; fix and push again, or use" >&2
    echo "pre-push gate: 'git push --no-verify' deliberately and say so." >&2
    exit 1
  fi

  # The model review stage. Exits nonzero only in blocking mode (or on a usage error), so
  # in the default advisory mode this refuses nothing and only surfaces findings.
  if [ -n "$base" ]; then
    $REVIEW --base "$base" >&2 < /dev/null
  else
    $REVIEW >&2 < /dev/null
  fi
  rcode=$?
  if [ "$rcode" -ne 0 ]; then
    echo "pre-push gate: REFUSING the push (review exit $rcode under HEALBOT_REVIEW=${HEALBOT_REVIEW:-advisory})." >&2
    echo "pre-push gate: review evidence in gate/runs/*-review.json." >&2
    exit 1
  fi

  # The evidence flow, detached (the sha exists remotely only after the transfer this hook
  # precedes; publish.py retries until it appears, and gives up on record if it never does).
  if [ "${HEALBOT_PUBLISH:-on}" != "off" ]; then
    nohup $PUBLISH --sha "$local_sha" --ref "$remote_ref" --since "$T0" \
      >> "$ROOT/gate/runs/publish.log" 2>&1 < /dev/null &
    echo "pre-push gate: evidence publisher spawned (gate/runs/publish.log)" >&2
  fi
done

exit 0
