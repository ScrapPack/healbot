#!/bin/bash
# The gate's enforcement trigger: a push whose commits do not pass gate/gate.py does not
# leave the machine. This closes the remember-to-run gap that GATE.MAP.md names as the reason
# the gate exists (the fork drift check sat silently red because nothing ran it).
#
# Install, once per clone (hooks are not versioned; this directory is):
#     git config core.hooksPath gate/hooks
# Escape hatch, git-native and deliberate: git push --no-verify. Using it means shipping
# unverified commits; say so wherever the push is discussed.
#
# Scope: the hook hands gate.py the exact pushed range, --base <remote sha> --head <local
# sha>, so even a push of a ref the checkout does not have checked out diffs
# base...pushed-tip. Run 20260802-184854 is the counterexample this guards: gate.py used to
# diff base...HEAD, this checkout sat parked on an ancestor branch, and a merge push
# bringing 800+ new lines gated as "0 changed file(s)" with every change-scoped linter
# skipped. Tier-1 probes and the invariant scans still read the checkout tree (gate.py
# prints a NOTE when that tree is not the pushed tip); lint reads the pushed blobs.
#
# After the gate passes, the model review stage (gate/review.py) runs on the same range:
# single-pass, fresh-context, typed findings, ADVISORY by default (findings are printed and
# recorded; the push continues). HEALBOT_REVIEW=blocking is fail-closed on severity: any
# finding not explicitly tagged warning or info refuses the push.
# HEALBOT_REVIEW=off skips the stage entirely. The reviewer needs a logged-in claude CLI;
# until one exists it reports ERROR and, in advisory mode, the push continues.
#
# HEALBOT_GATE / HEALBOT_REVIEW_CMD override the two commands for hook plumbing tests
# (stub exits 0/2/3). They add no bypass power that --no-verify does not already grant.
# After both stages pass, the evidence flow (gate/publish.py) is spawned DETACHED: it waits
# for the pushed sha to appear on the remote, then attaches the run records to the commit
# (or the branch's open PR). It never blocks a push; HEALBOT_PUBLISH=off skips it. The
# auditable property: a pushed commit with no evidence comment shipped via --no-verify.
set -u

ZERO=0000000000000000000000000000000000000000
ROOT="$(git rev-parse --show-toplevel)"
# The probe interpreter lives in the rig venv, which has two layouts (docs/WINDOWS.md):
# POSIX bin/, Windows Scripts/. Choose between them only when one is PRESENT. A fresh clone
# or fresh git worktree has no venv at all — it is gitignored; the suite is not portable
# (HARNESS.md "Traps") — and the old fall-through picked the Windows layout there, dying
# mid-loop with "Scripts/python.exe: No such file or directory ... gate exit 127, unknown":
# a Windows path and a wrong diagnosis on macOS. Measured 2026-08-02 from a scratch worktree.
VENV="$ROOT/.carryover/verified/venv"
if [ -x "$VENV/bin/python" ]; then
  VENVPY="$VENV/bin/python"
elif [ -x "$VENV/Scripts/python.exe" ]; then
  VENVPY="$VENV/Scripts/python.exe"
else
  VENVPY=""
fi
GATE=${HEALBOT_GATE:-"$VENVPY $ROOT/gate/gate.py"}
REVIEW=${HEALBOT_REVIEW_CMD:-"$VENVPY $ROOT/gate/review.py"}
PUBLISH=${HEALBOT_PUBLISH_CMD:-"$VENVPY $ROOT/gate/publish.py"}
# staleness.py is stdlib-only by design, so it would run on a bare interpreter; it takes
# $VENVPY anyway so every stage on this hook reports from one environment.
STALE=${HEALBOT_STALE_CMD:-"$VENVPY $ROOT/gate/staleness.py"}

# A missing venv is a named precondition, not an unknown failure: refuse with the remedy,
# the way doctor.py ("rig venv not built") and hb-fleet preflight ("rig venv absent") name
# it. Refuse only when a stage below would actually run $VENVPY: a fully stubbed plumbing
# run (HEALBOT_GATE and HEALBOT_REVIEW_CMD set, publish off or stubbed) never touches the
# venv and proceeds as before — the stubs already had that power. HEALBOT_REVIEW=off does
# NOT excuse the venv: the off-switch lives inside review.py, which still needs an
# interpreter to reach it. The refusal itself fires INSIDE the ref loop, after the
# deletion skip: a deletion-only push (every local sha ZERO) gates nothing and passes
# venv-free, exactly as it did before the refusal existed — a fresh clone deleting a
# remote branch has nothing to measure. No buffering of stdin: the loop is the direct
# reader, the original architecture.
needs_venv=""
if [ -z "$VENVPY" ]; then
  [ -z "${HEALBOT_GATE:-}" ] && needs_venv=1
  [ -z "${HEALBOT_REVIEW_CMD:-}" ] && needs_venv=1
  [ "${HEALBOT_PUBLISH:-on}" != "off" ] && [ -z "${HEALBOT_PUBLISH_CMD:-}" ] && needs_venv=1
fi
T0=$(date +%s)

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote ref pushes no commits; there is nothing to gate.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ -n "$needs_venv" ]; then
    echo "pre-push gate: REFUSING the push (rig venv not built: no interpreter under" >&2
    echo "pre-push gate: .carryover/verified/venv — neither bin/python nor Scripts/python.exe)." >&2
    echo "pre-push gate: a fresh clone or fresh worktree starts this way; nothing ran, nothing was measured." >&2
    echo "pre-push gate: build it per .carryover/verified/README.md (docs/CLONE.md is the full story)," >&2
    echo "pre-push gate: or 'git push --no-verify' deliberately and say so." >&2
    exit 1
  fi

  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$remote_sha"                    # normal push: gate exactly what the remote gains
  else
    # New remote ref, or a remote tip we have not fetched: fall back to the merge-base with
    # origin/main, and to a working-tree run if even that is unknown.
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  fi

  echo "pre-push gate: ${local_ref} -> ${remote_ref} (base ${base:-working tree})" >&2
  # /dev/null on stdin: a command inside a while-read loop otherwise inherits the loop's
  # stdin and can consume the remaining ref lines.
  if [ -n "$base" ]; then
    $GATE --base "$base" --head "$local_sha" >&2 < /dev/null
  else
    $GATE >&2 < /dev/null
  fi
  code=$?
  if [ "$code" -ne 0 ]; then
    meaning="unknown"
    [ "$code" -eq 2 ] && meaning="BLOCKED: a check ran and said no"
    [ "$code" -eq 3 ] && meaning="ERROR: a check could not run, so the claim is unmeasured"
    echo "pre-push gate: REFUSING the push (gate exit $code, $meaning)." >&2
    echo "pre-push gate: evidence in gate/runs/; fix and push again, or use" >&2
    echo "pre-push gate: 'git push --no-verify' deliberately and say so." >&2
    exit 1
  fi

  # The model review stage. Exits nonzero only in blocking mode (or on a usage error), so
  # in the default advisory mode this refuses nothing and only surfaces findings.
  if [ -n "$base" ]; then
    $REVIEW --base "$base" --head "$local_sha" >&2 < /dev/null
  else
    $REVIEW >&2 < /dev/null
  fi
  rcode=$?
  if [ "$rcode" -ne 0 ]; then
    echo "pre-push gate: REFUSING the push (review exit $rcode under HEALBOT_REVIEW=${HEALBOT_REVIEW:-advisory})." >&2
    echo "pre-push gate: review evidence in gate/runs/*-review.json." >&2
    exit 1
  fi

  # The citation-staleness stage: which documents point at lines this push moved. It answers
  # the question review.py cannot, because gate/review.py:75 scopes the reviewer to the change
  # and a document this change invalidated but did not touch is out of scope by construction.
  #
  # SHADOW MODE while the flag rate is being calibrated: it writes gate/runs/*-staleness.json
  # and prints no FINDINGS. It does print a one-line stderr notice when it could not measure at
  # all, in every mode, because a failure is not a finding and a stage that quietly stopped
  # working must not read like a clean one. Two replays of historical pushes disagreed by more
  # than 4x on the mean, and both used today's corpus against old diffs, so both are lower
  # bounds. Live records settle it. HEALBOT_STALE_SHOW=1 prints the findings now;
  # HEALBOT_STALE=off skips the stage.
  #
  # It is deliberately NOT allowed to refuse. Range mode only: with no base it returns 0
  # without measuring, because gate.changed_files unions untracked files in working-tree mode
  # while `git diff -U0` emits nothing for them, so every citation into a newly added file
  # would classify as rewritten against an empty old side.
  if [ -n "$base" ]; then
    $STALE --base "$base" --head "$local_sha" >&2 < /dev/null || true
  fi

  # The prose stage: plainspec's machine rules over the changed .md, ADVISORY like staleness.
  # Blocking is not an option at the measured rate — 2.80 violations per 100 words over the
  # tracked corpus, 5 of 104 files clean — so a blocking row would refuse every push.
  # HEALBOT_PROSE=off skips it.
  #
  # SCOPE IS THE WORKING TREE, not the pushed blobs: the checker takes file paths. On a push from
  # a checkout parked elsewhere the density therefore describes the tree, not the range — which is
  # why this reports and never refuses. `--diff-filter=d` drops deletions so a removed document
  # is not handed to the checker as a missing path.
  if [ -n "$base" ] && [ "${HEALBOT_PROSE:-on}" != "off" ]; then
    # -z, read into an ARRAY, and quoted at the call. Git QUOTES a path containing a space or a
    # non-ASCII byte in its default --name-only output, and the old unquoted `$md` expansion then
    # split that one path into several names matching nothing — the file left the scan in silence.
    # Third instance of this bug class here, after harness/memory.py and rig.py's ls-files read.
    md=()
    while IFS= read -r -d '' f; do
      case "$f" in opencode/*) continue ;; esac
      [ -f "$ROOT/$f" ] && md+=("$f")
    done < <(git diff -z --name-only --diff-filter=d "$base...$local_sha" -- '*.md')
    if [ ${#md[@]} -gt 0 ]; then
      echo "-- prose (advisory, working tree): ${#md[@]} changed .md" >&2
      # Density per file only. The full violation list runs to hundreds of lines on a docs push,
      # and a stage that floods stderr is a stage people stop reading. Re-run the checker by hand
      # for the detail: harness/skills/plainspec-check.py --score <file>
      #
      # The checker's stderr goes STRAIGHT THROUGH and its exit status is read. The old form piped
      # `2>&1` into grep and ended in `|| true`, so a checker that crashed printed this stage's
      # header and then nothing at all: an ERROR rendered as a clean PASS, which is the exact
      # collapse gate.py's typed states exist to prevent, rebuilt inside the gate.
      # shellcheck disable=SC2086
      # < /dev/null for the reason given at the top of this loop: a command inside `while read`
      # inherits the loop's stdin and can eat the remaining ref lines. plainspec-check never reads
      # stdin, so this is the rule rather than a live bug — and every other stage here obeys it.
      prose_out=$(cd "$ROOT" && $VENVPY harness/skills/plainspec-check.py --score "${md[@]}" < /dev/null)
      prose_rc=$?
      if [ "$prose_rc" -ge 2 ]; then
        echo "   ERROR: plainspec-check exited $prose_rc — prose NOT checked for this push" >&2
      else
        printf '%s\n' "$prose_out" | grep -E "violations per 100 words" | sed 's/^/   /' >&2
      fi
    fi
  fi

  # The evidence flow, detached (the sha exists remotely only after the transfer this hook
  # precedes; publish.py retries until it appears, and gives up on record if it never does).
  if [ "${HEALBOT_PUBLISH:-on}" != "off" ]; then
    nohup $PUBLISH --sha "$local_sha" --ref "$remote_ref" --since "$T0" \
      >> "$ROOT/gate/runs/publish.log" 2>&1 < /dev/null &
    echo "pre-push gate: evidence publisher spawned (gate/runs/publish.log)" >&2
  fi
done

exit 0
